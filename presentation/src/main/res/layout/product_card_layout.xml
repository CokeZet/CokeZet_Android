<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="productInfo"
            type="buy.coke.zet.presentation.product.list.ProductInfo" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/product_card_drawable"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp">
        
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/shopping_icon_container"
            android:layout_width="34dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:paddingBottom="7dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:background="@drawable/simple_shopping_container_drawable"
            android:src="@drawable/icon_simple_eleventhstreet"
            android:scaleType="fitEnd"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/product_image"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:background="@drawable/product_image_drawable"
            android:src="@drawable/pepsi_sample"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/discount_label"
            android:layout_width="68dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/zetpick_tag"
            app:layout_constraintStart_toEndOf="@id/product_image"
            app:layout_constraintTop_toTopOf="@id/product_image"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:text="@{productInfo.title}"
            tools:text="펩시 제로 355ml 24개"
            app:layout_constraintStart_toEndOf="@id/product_image"
            app:layout_constraintTop_toBottomOf="@+id/discount_label"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/discount_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/red_500"
            android:textSize="16sp"
            android:text="@{productInfo.discountRate + `%`}"
            tools:text="24%"
            app:layout_constraintStart_toEndOf="@id/product_image"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintBottom_toBottomOf="@id/product_image"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="16sp"
            android:text="@{productInfo.price}"
            tools:text="16,000₩"
            app:layout_constraintStart_toEndOf="@id/discount_rate"
            app:layout_constraintTop_toTopOf="@id/discount_rate"
            app:layout_constraintBottom_toBottomOf="@id/discount_rate"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/delivery_fee_conatins_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/contains_delivery_fee"
            android:textSize="10sp"
            android:textColor="@color/red_100"
            app:layout_constraintStart_toEndOf="@id/price"
            app:layout_constraintTop_toTopOf="@id/price"
            app:layout_constraintBottom_toBottomOf="@id/price"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/gray_600"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/product_image"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/card_favor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="19dp"
            android:layout_marginBottom="17dp"
            android:text="@string/card_favor"
            android:textColor="@color/gray_500"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <LinearLayout
            android:id="@+id/card_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginTop="19dp"
            android:layout_marginBottom="17dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintStart_toEndOf="@id/card_favor_title"
            app:layout_constraintTop_toTopOf="@id/card_favor_title"
            app:layout_constraintBottom_toBottomOf="@id/card_favor_title">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/favor_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/shinhan_defaulticon" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/favor_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/kookmin_defaulticon"
                android:layout_marginStart="6dp"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/favor_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/lotte_defaulticon"
                android:layout_marginStart="6dp"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/favor_4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/hyundai_defaulticon"
                android:layout_marginStart="6dp"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/favor_5"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/samgsung_defaulticon"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

