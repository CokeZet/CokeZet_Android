<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="buy.coke.zet.common.designsystem.TopBarStyle"/>
        <import type="buy.coke.zet.common.designsystem.RoundButtonStyle"/>
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <buy.coke.zet.common.designsystem.topbar.TopBar
            android:id="@+id/product_detail_topbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:leftIconImage="@{TopBarStyle.Image.BACK}"
            app:rightFirstIconImage="@{TopBarStyle.Image.NOTIFICATION}"
            app:rightSecondIconImage="@{TopBarStyle.Image.PERSON}"
            app:rightThirdIconImage="@{TopBarStyle.Image.HOME}"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:context=".product.detail.ProductDetailActivity">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/product_image"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@color/gray_900"
                    android:src="@drawable/pepsi_sample"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/label_image"
                    android:layout_width="63dp"
                    android:layout_height="24dp"
                    android:src="@drawable/zetpick_tag"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintTop_toTopOf="@id/product_image"
                    app:layout_constraintEnd_toEndOf="@id/product_image"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/product_info_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/product_information_item_drawable"
                    app:layout_constraintTop_toBottomOf="@id/product_image">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/coke_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coca_cola_drink"
                        android:textColor="@color/gray_600"
                        android:textSize="14sp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="32dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/product_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="코카롤라 제로 190ml (12개)"
                        android:textSize="20sp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="@id/coke_type"
                        app:layout_constraintTop_toBottomOf="@id/coke_type"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lowest_price_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gray_500"
                        android:textSize="14sp"
                        android:text="@string/lowest_price"
                        app:layout_constraintStart_toStartOf="@id/product_title"
                        app:layout_constraintTop_toTopOf="@id/product_price"
                        app:layout_constraintBottom_toBottomOf="@id/product_price"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/product_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textColor="@color/red_500"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="15dp"
                        android:text="13,000원"
                        app:layout_constraintTop_toBottomOf="@id/product_title"
                        app:layout_constraintStart_toEndOf="@id/lowest_price_title"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/unit_price_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gray_500"
                        android:textSize="14sp"
                        android:text="@string/unit_price"
                        app:layout_constraintStart_toStartOf="@id/lowest_price_title"
                        app:layout_constraintTop_toTopOf="@id/product_unit_price"
                        app:layout_constraintBottom_toBottomOf="@id/product_unit_price"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/product_unit_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="14sp"
                        android:text="193원"
                        app:layout_constraintTop_toBottomOf="@id/product_price"
                        app:layout_constraintStart_toStartOf="@id/product_price"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/store_site_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gray_500"
                        android:textSize="14sp"
                        android:text="@string/store_site"
                        app:layout_constraintStart_toStartOf="@id/unit_price_title"
                        app:layout_constraintTop_toTopOf="@id/store_logo"
                        app:layout_constraintBottom_toBottomOf="@id/store_logo"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/store_logo"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="12dp"
                        android:src="@drawable/kookmin_defaulticon"
                        app:layout_constraintTop_toBottomOf="@id/product_unit_price"
                        app:layout_constraintStart_toStartOf="@id/product_unit_price"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/delivery_fee_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delivery_fee"
                        android:textColor="@color/gray_500"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="@id/product_delivery_fee"
                        app:layout_constraintBottom_toBottomOf="@id/product_delivery_fee"
                        app:layout_constraintStart_toStartOf="@id/store_site_title"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/product_delivery_fee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="14sp"
                        android:text="3,000원 별도"
                        app:layout_constraintStart_toStartOf="@id/store_logo"
                        app:layout_constraintTop_toBottomOf="@id/store_logo"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/card_discount_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_discount"
                        android:textColor="@color/gray_500"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="@id/card_discount"
                        app:layout_constraintBottom_toBottomOf="@id/card_discount"
                        app:layout_constraintStart_toStartOf="@id/delivery_fee_title"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/card_discount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:textSize="14sp"
                        android:text="신한카드 12,300원"
                        app:layout_constraintStart_toStartOf="@id/product_delivery_fee"
                        app:layout_constraintTop_toBottomOf="@id/product_delivery_fee"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/condition_label"
                        android:layout_width="69dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/condition_cotain_tag"
                        app:layout_constraintStart_toEndOf="@id/card_discount"
                        app:layout_constraintTop_toTopOf="@id/card_discount"
                        app:layout_constraintBottom_toBottomOf="@id/card_discount"/>

                    <buy.coke.zet.common.designsystem.normalbutton.RoundButton
                        android:id="@+id/buy_button"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="41dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        app:mainColor="@{RoundButtonStyle.Color.RED}"
                        app:buttonText="@{@string/buy_with_lowest_price}"
                        app:layout_constraintTop_toBottomOf="@id/card_discount"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/advertise_box_container"
                        android:layout_width="match_parent"
                        android:layout_height="132dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/product_advertisement_drawable"
                        app:layout_constraintTop_toBottomOf="@id/buy_button">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/advertise_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:lines="2"
                            android:lineSpacingMultiplier="1.24"
                            android:text="신한카드, 국민카드가 있다면 이 가격에 구입 가능해요!"
                            app:layout_constraintVertical_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/advertise_shopping_icon"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/advertise_price"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/advertise_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/red_500"
                            android:textSize="18sp"
                            android:text="13,000원"
                            app:layout_constraintStart_toStartOf="@id/advertise_text"
                            app:layout_constraintTop_toBottomOf="@id/advertise_text"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/condition_cotain_label"
                            android:layout_width="62dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/condition_cotain_tag"
                            app:layout_constraintTop_toTopOf="@id/advertise_price"
                            app:layout_constraintBottom_toBottomOf="@id/advertise_price"
                            app:layout_constraintStart_toEndOf="@id/advertise_price"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/advertise_shopping_icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/navershopping_defaulticon"
                            app:layout_constraintEnd_toStartOf="@id/next_button"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/next_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="20dp"
                            android:src="@drawable/gray_next"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/top_divider"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:background="@color/gray_900"
                        android:layout_marginTop="24dp"
                        app:layout_constraintTop_toBottomOf="@id/advertise_box_container"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/price_graph_image"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:src="@drawable/price_graph_zetpick"
                        app:layout_constraintTop_toBottomOf="@id/top_divider"
                        app:layout_constraintBottom_toTopOf="@id/bottom_divider"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/graph_tooltip"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="47dp"
                        android:layout_marginTop="30dp"
                        android:src="@drawable/tooptip_icon"
                        app:layout_constraintTop_toTopOf="@id/price_graph_image"
                        app:layout_constraintEnd_toEndOf="@id/price_graph_image"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/graph_summation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:fontFamily="@font/suit_medium"
                        android:text="현재 100ml당 193원"
                        android:layout_marginEnd="4dp"
                        app:layout_constraintEnd_toStartOf="@id/graph_tooltip"
                        app:layout_constraintTop_toTopOf="@id/graph_tooltip"
                        app:layout_constraintBottom_toBottomOf="@id/graph_tooltip"/>

                    <TextView
                        android:id="@+id/bottom_divider"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:background="@color/gray_900"
                        app:layout_constraintBottom_toTopOf="@id/advertise_card_container"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/advertise_card_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/gray_800"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/price_graph_image">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/compare_price_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="@string/compare_price"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/more_button"
                            app:layout_constraintBottom_toBottomOf="@id/more_button"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/comparison_tooltip"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/tooptip_icon"
                            app:layout_constraintStart_toEndOf="@id/compare_price_title"
                            app:layout_constraintTop_toTopOf="@id/compare_price_title"
                            app:layout_constraintBottom_toBottomOf="@id/compare_price_title"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/more_button"
                            android:layout_width="108dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="28dp"
                            android:textColor="@color/purple_600"
                            android:textSize="16sp"
                            android:background="@drawable/more_button_drawable"
                            android:gravity="center"
                            android:text="132개 더보기"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <include
                            layout="@layout/layout_product_information_item"
                            android:id="@+id/card_1"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintTop_toBottomOf="@id/more_button" />

                        <include
                            layout="@layout/layout_product_information_item"
                            android:id="@+id/card_2"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@id/card_1" />

                        <include
                            layout="@layout/layout_product_information_item"
                            android:id="@+id/card_3"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@id/card_2" />

                        <include
                            layout="@layout/layout_product_information_item"
                            android:id="@+id/card_4"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@id/card_3" />

                        <include
                            layout="@layout/layout_product_information_item"
                            android:id="@+id/card_5"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="24dp"
                            app:layout_constraintTop_toBottomOf="@id/card_4"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:background="@color/gray_900"
                        app:layout_constraintTop_toBottomOf="@id/advertise_card_container"
                        app:layout_constraintBottom_toTopOf="@id/detail_info_container"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/detail_info_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/advertise_card_container">

                        <TextView
                            android:id="@+id/product_info_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/product_information"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="28dp"
                            android:textSize="18sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/divider_line"
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="72dp"
                            android:background="@color/gray_500"
                            app:layout_constraintTop_toBottomOf="@id/product_type_top_line"
                            app:layout_constraintBottom_toTopOf="@id/bottom_line"
                            app:layout_constraintStart_toStartOf="@id/product_type_top_line" />

                        <TextView
                            android:id="@+id/product_type_top_line"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="24dp"
                            android:background="@color/gray_500"
                            app:layout_constraintTop_toBottomOf="@id/product_info_title"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/product_type_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginStart="4dp"
                            android:text="@string/product_type"
                            app:layout_constraintStart_toStartOf="@id/product_type_top_line"
                            app:layout_constraintTop_toTopOf="@id/product_type_top_line"
                            app:layout_constraintBottom_toBottomOf="@id/wrap_type_top_line"/>

                        <TextView
                            android:id="@+id/wrap_type_top_line"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="38dp"
                            android:background="@color/gray_500"
                            app:layout_constraintTop_toBottomOf="@id/product_type_top_line"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/wrap_type_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginStart="4dp"
                            android:text="@string/wrap_type"
                            app:layout_constraintStart_toStartOf="@id/wrap_type_top_line"
                            app:layout_constraintTop_toTopOf="@id/wrap_type_top_line"
                            app:layout_constraintBottom_toBottomOf="@id/volume_top_line"/>

                        <TextView
                            android:id="@+id/volume_top_line"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="38dp"
                            android:background="@color/gray_500"
                            app:layout_constraintTop_toBottomOf="@id/wrap_type_top_line"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/volume_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginStart="4dp"
                            android:text="@string/volume"
                            app:layout_constraintStart_toStartOf="@id/volume_top_line"
                            app:layout_constraintTop_toTopOf="@id/volume_top_line"
                            app:layout_constraintBottom_toBottomOf="@id/count_top_line"/>

                        <TextView
                            android:id="@+id/count_top_line"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="38dp"
                            android:background="@color/gray_500"
                            app:layout_constraintTop_toBottomOf="@id/volume_top_line"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/count_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginStart="4dp"
                            android:text="@string/number"
                            app:layout_constraintStart_toStartOf="@id/count_top_line"
                            app:layout_constraintTop_toTopOf="@id/count_top_line"
                            app:layout_constraintBottom_toBottomOf="@id/point_top_line"/>

                        <TextView
                            android:id="@+id/point_top_line"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="38dp"
                            android:background="@color/gray_500"
                            app:layout_constraintTop_toBottomOf="@id/count_top_line"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/point_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginStart="4dp"
                            android:text="@string/point"
                            app:layout_constraintStart_toStartOf="@id/point_top_line"
                            app:layout_constraintTop_toTopOf="@id/point_top_line"
                            app:layout_constraintBottom_toBottomOf="@id/bottom_line"/>

                        <TextView
                            android:id="@+id/bottom_line"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="38dp"
                            android:layout_marginBottom="24dp"
                            android:background="@color/gray_500"
                            app:layout_constraintTop_toBottomOf="@id/point_top_line"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

