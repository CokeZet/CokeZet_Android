<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="buy.coke.zet.common.designsystem.RectangleButtonStyle.Color"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/long_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/normal_dialog">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="ZET와의 최저가 탐색을 정말 그만두시겠어요?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="36dp"
            android:layout_marginBottom="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/dialog_warning"/>

        <TextView
            android:id="@+id/dialog_warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="확인 시 바로 탈퇴됩니다."
            android:layout_marginStart="20dp"
            android:layout_marginEnd="36dp"
            android:layout_marginBottom="13dp"
            android:textColor="@color/red_600"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dialog_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/button_barrier_top"/>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/button_barrier_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:layout_constraintTop_toBottomOf="@id/dialog_warning"
            app:constraint_referenced_ids="cancel_button, okay_button"/>

        <buy.coke.zet.common.designsystem.normalbutton.RectangleButton
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="20dp"
            app:buttonText="@{@string/no}"
            app:mainColor="@{Color.WHITE}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_warning"
            app:layout_constraintEnd_toStartOf="@id/okay_button"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <buy.coke.zet.common.designsystem.normalbutton.RectangleButton
            android:id="@+id/okay_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            app:buttonText="@{@string/yes}"
            app:mainColor="@{Color.GRAY}"
            app:layout_constraintStart_toEndOf="@id/cancel_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_warning"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
